# ===============================================
# FinVigil Central - Environment Configuration
# ===============================================

# --- Database Configuration (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finvigil_db
DB_USERNAME=finvigil_user
DB_PASSWORD=finvigil_secure_password
DB_URL=jdbc:postgresql://localhost:5432/finvigil_db

# --- Cache Configuration (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Message Broker Configuration (RabbitMQ) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- Security / JWT Configuration ---
# 256-bit secret key for HMAC-SHA256
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# --- Server Ports ---
SERVER_PORT=8080
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# --- AML Velocity & Rule Thresholds ---
AML_LARGE_TRANSACTION_THRESHOLD=50000.0
AML_VELOCITY_LIMIT=5
AML_VELOCITY_WINDOW_SECONDS=60
AML_RULE_WEIGHT=0.4
AML_ML_WEIGHT=0.6

# --- Employee Default Admin Bootstrap ---
DEFAULT_ADMIN_EMAIL=admin@finvigil.internal
DEFAULT_ADMIN_PASSWORD=<set-a-local-secret>

